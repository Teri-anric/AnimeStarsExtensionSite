bucket           = "terraform-state"
key              = "animestars-extensionsite/prod/terraform.tfstate"
region           = "us-east-1"
endpoints        = { s3 = "https://s3.strawberrycat.dev" }
use_path_style    = true

skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
use_lockfile                = true

# Export AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY before terraform init.
