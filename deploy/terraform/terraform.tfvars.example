# Authorized workstation kubeconfig for the existing s1 K3s cluster.
kubeconfig_path = "~/.kube/k3s-s1.yaml"
kube_context    = "k3s"

# The K3s local-path provisioner creates and retains the PostgreSQL PVC data.
node_name       = "s0.teri"
volume_capacity = "10Gi"

# Replace these placeholders with the live Secret values in an ignored local
# terraform.tfvars file. This Secret's values are stored in remote TF state.
runtime_secret_data = {
  DATABASE__USER     = "REPLACE_WITH_LIVE_VALUE"
  DATABASE__PASSWORD = "REPLACE_WITH_LIVE_VALUE"
  DATABASE__DB       = "REPLACE_WITH_LIVE_VALUE"
}
