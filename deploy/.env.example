# SSH account/address on s1 for deployment operations that still use SSH.
SSH_TARGET=teri@s1.example.net

# Authenticated public HTTPS container registry used by prod:push.
REGISTRY_HOST=registry.strawberrycat.dev
# Set REGISTRY_ACCESS_TOKEN in this ignored file or export it in the environment.
# REGISTRY_ACCESS_TOKEN=

# Workstation kubeconfig and context for the existing two-node K3s cluster.
KUBECONFIG_PATH=~/.kube/k3s-s1.yaml
KUBE_CONTEXT=k3s

# Optional overrides for the public frontend's API origin.
# VITE_API_URL=https://ass-api.strawberrycat.dev
