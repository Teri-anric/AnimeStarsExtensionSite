# SSH account/address on s1. Docker pushes through an SSH local forward to the
# existing sanberry-registry/registry ClusterIP; the registry is not published.
SSH_TARGET=teri@s1.example.net

# Workstation kubeconfig and context for the existing two-node K3s cluster.
KUBECONFIG_PATH=~/.kube/k3s-s1.yaml
KUBE_CONTEXT=k3s

# Optional overrides for the public frontend's API origin.
# VITE_API_URL=https://ass-api.strawberrycat.dev
